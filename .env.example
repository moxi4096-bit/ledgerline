# Copy to .env (git-ignored). Testnet keys only.
# Either a raw key...
# PRIVATE_KEY=0x...
# ...or the JSON file written by `cast wallet new --json`:
KEY_FILE=../secrets/testnet-wallet.json

# Optional: a second wallet you own, to demo transfers between your own wallets.
# SECOND_WALLET=0x...
# SECOND_KEY_FILE=../secrets/testnet-wallet-2.json

# Optional overrides
# REACTIVE_FUNDING=3ether
# CALLBACK_FUNDING=0.005ether
# DAILY_LIMIT=100000000
# SAVINGS_BPS=1000
# STATEMENT_INTERVAL=3600
